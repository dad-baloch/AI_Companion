# ==============================================
# Offline AI Companion — .gitignore
# ==============================================

# Model weights (too large for git)
models/**
!models/.gitkeep

# Log files
logs/**
!logs/.gitkeep

# Environment
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/

# Audio temp files
temp_audio/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Benchmark outputs (keep structure, ignore data)
benchmarks/results/**
!benchmarks/results/.gitkeep
benchmarks/test_audio/

# Session data
logs/sessions/
